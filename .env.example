# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_GROUP_CHAT_ID="-1001234567890"

# Google Gemini API
GEMINI_API_KEY="your_gemini_api_key_here"

# Security & Access Whitelist (Comma-separated Telegram User IDs)
ALLOWED_TELEGRAM_USERS="123456789,987654321"

# Vector Embeddings
EMBEDDING_MODEL="models/gemini-embedding-001"
EMBEDDING_DIM=768

# Telemetry & Health Canary
CANARY_REEL_URL="https://www.instagram.com/reel/example/"

# Storage Management (Set to false during debugging to preserve downloaded files)
CLEANUP_TEMP=true

# Forum Topic Thread IDs (Optional)
TOPIC_RECIPE=""
TOPIC_TECH=""
TOPIC_WORKOUT=""
TOPIC_IDEA=""
TOPIC_TRAVEL=""
TOPIC_FINANCE=""
TOPIC_OTHER=""

# Channel Monitor Radar
CHANNEL_CHECK_INTERVAL_MINS=30

# Direct Instagram DM Ingestion (Optional)
INSTAGRAM_SESSION_ID=""
INSTAGRAM_USERNAME=""
INSTAGRAM_PASSWORD=""
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=""
